{
  "version": 10,
  "cmakeMinimumRequired": { "major": 3, "minor": 31, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    { "name": "windows-msvc", "inherits": "base", "displayName": "Windows / MSVC 18 x64" },
    { "name": "windows-arm64", "inherits": "base", "displayName": "Windows / MSVC 18 ARM64" },
    {
      "name": "windows-tidy",
      "inherits": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-tidy",
      "displayName": "Windows / clang-tidy",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "windows-arm64-tidy",
      "inherits": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-arm64-tidy",
      "displayName": "Windows ARM64 / clang-tidy",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    { "name": "linux-gcc", "inherits": "base", "displayName": "Linux / GCC" },
    { "name": "macos-clang", "inherits": "base", "displayName": "macOS / AppleClang" }
  ],
  "buildPresets": [
    { "name": "windows-debug", "configurePreset": "windows-msvc", "configuration": "Debug" },
    { "name": "windows-arm64-debug", "configurePreset": "windows-arm64", "configuration": "Debug" },
    { "name": "windows-release", "configurePreset": "windows-msvc", "configuration": "Release" },
    { "name": "windows-arm64-release", "configurePreset": "windows-arm64", "configuration": "Release" },
    { "name": "windows-tidy", "configurePreset": "windows-tidy" },
    { "name": "windows-arm64-tidy", "configurePreset": "windows-arm64-tidy" },
    { "name": "linux-debug", "configurePreset": "linux-gcc", "configuration": "Debug" },
    { "name": "macos-debug", "configurePreset": "macos-clang", "configuration": "Debug" }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-arm64-debug",
      "configurePreset": "windows-arm64",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-gcc",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "macos-debug",
      "configurePreset": "macos-clang",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
